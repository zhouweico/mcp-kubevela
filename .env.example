# ==== MCP 传输与认证 ====
MCP_TRANSPORT=streamable-http        # stdio / sse / streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_AUTH_TOKEN=                      # 设置后启用 Bearer Token 认证，保护 HTTP 接口
MCP_STATELESS_HTTP=false             # true 时启用 Stateless HTTP 模式（无会话状态，每次请求独立）
MCP_LOG_LEVEL=info                   # debug / info / warning / error

# ==== VelaUX 连接配置 ====
VELA_URL=http://localhost:8000       # VelaUX API Server 地址
VELA_USERNAME=                       # 登录用户名（必填）
VELA_PASSWORD=                       # 登录密码（必填）
VELA_TIMEOUT=30                      # 请求超时（秒）
VELA_READ_ONLY=false                 # true 时排除全部写工具，仅允许查询
VELA_INSECURE=false                  # true 时跳过 TLS 证书验证（仅开发/测试环境使用）
